# Required for the knowledge base and the document-management area.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Required to create semantic embeddings when importing or editing a document.
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: powers the "Ask NHRC" grounded Q&A over the case-note index.
# Without it, /api/ask-nhrc still returns matched cases, just without an AI summary.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: powers real semantic search for "Ask NHRC" (Gemini embeddings +
# Supabase pgvector - see web/scripts/embed-nhrc-documents.mjs and
# supabase/nhrc_embeddings_schema.sql). Without it, falls back to the old
# literal-keyword-substring match (repository.ts's findRelevantCases).
GEMINI_API_KEY=your-gemini-api-key

# Optional: serves NHRC case source PDFs from Google Drive in production,
# where data/nhrc_documents/ (1.4GB, gitignored) isn't on disk. See
# scripts/gdrive_oauth_setup.py and HANDOFF.md - these three values come
# from the google_drive_token.json that script writes (gitignored, never
# commit it). Without these, the "open source PDF" button just 404s.
GOOGLE_DRIVE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-oauth-refresh-token

# Required for the local administrator login. Use a long, unique value.
ADMIN_IMPORT_SECRET=replace-with-a-long-random-secret

# Optional: set this to true when HTTPS is terminated outside Next.js.
ADMIN_COOKIE_SECURE=true
